FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y gcc postgresql-client && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY newsletter_backend.py warren_analyzer.py logging_config.py api_docs.py gunicorn_config.py ./

EXPOSE 5000

CMD ["gunicorn", "--config", "gunicorn_config.py", "newsletter_backend:app"]
